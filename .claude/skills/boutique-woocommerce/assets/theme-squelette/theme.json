{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "1240px",
			"wideSize": "1400px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "fond",
					"color": "#FFFFFF",
					"name": "Fond"
				},
				{
					"slug": "surface",
					"color": "#F4F4F4",
					"name": "Surface (cartes, champs)"
				},
				{
					"slug": "texte",
					"color": "#111111",
					"name": "Texte"
				},
				{
					"slug": "sourdine",
					"color": "#6B6B6B",
					"name": "Texte secondaire"
				},
				{
					"slug": "trait",
					"color": "#E3E3E3",
					"name": "Traits et bordures"
				},
				{
					"slug": "accent",
					"color": "#111111",
					"name": "Accent (boutons, liens)"
				},
				{
					"slug": "sur-accent",
					"color": "#FFFFFF",
					"name": "Texte sur l’accent"
				},
				{
					"slug": "promo",
					"color": "#B42318",
					"name": "Prix promotionnels"
				},
				{
					"slug": "alerte",
					"color": "#B42318",
					"name": "Alertes (erreurs)"
				}
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "titres",
					"name": "Titres",
					"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
				},
				{
					"slug": "texte",
					"name": "Texte",
					"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "petit",
					"name": "Petit",
					"size": "14px"
				},
				{
					"slug": "normal",
					"name": "Normal",
					"size": "16px"
				},
				{
					"slug": "chapeau",
					"name": "Chapeau",
					"size": "19px"
				},
				{
					"slug": "titre-3",
					"name": "Titre 3",
					"size": "22px"
				},
				{
					"slug": "titre-2",
					"name": "Titre 2",
					"size": "clamp(28px, 3.4vw, 44px)"
				},
				{
					"slug": "titre-1",
					"name": "Titre 1",
					"size": "clamp(40px, 5.4vw, 72px)"
				}
			]
		},
		"spacing": {
			"blockGap": true,
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "Court",
					"size": "16px"
				},
				{
					"slug": "40",
					"name": "Moyen",
					"size": "40px"
				},
				{
					"slug": "60",
					"name": "Grand",
					"size": "80px"
				},
				{
					"slug": "80",
					"name": "Section",
					"size": "120px"
				}
			]
		},
		"border": {
			"radius": true,
			"color": true,
			"style": true,
			"width": true
		},
		"custom": {
			"rayon": "10px",
			"rayon-bouton": "999px"
		}
	},
	"styles": {
		"spacing": {
			"blockGap": "0px"
		},
		"color": {
			"background": "var(--wp--preset--color--fond)",
			"text": "var(--wp--preset--color--texte)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--texte)",
			"fontSize": "16px",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--texte)"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--titres)",
					"fontWeight": "700",
					"lineHeight": "1.1",
					"letterSpacing": "-0.02em"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--sur-accent)"
				},
				"border": {
					"radius": "var(--wp--custom--rayon-bouton)"
				},
				"typography": {
					"fontFamily": "var(--police-texte)",
					"fontWeight": "600",
					"fontSize": "15px",
					"lineHeight": "1.2"
				},
				"spacing": {
					"padding": {
						"top": "15px",
						"bottom": "15px",
						"left": "28px",
						"right": "28px"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--texte)",
						"text": "var(--wp--preset--color--fond)"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "En-tête",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Pied de page",
			"area": "footer"
		},
		{
			"name": "checkout-header",
			"title": "En-tête de commande",
			"area": "header"
		},
		{
			"name": "mini-cart",
			"title": "Mini-panier",
			"area": "mini-cart"
		}
	]
}
